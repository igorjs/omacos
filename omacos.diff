--- a/install/shell.sh
+++ b/install/shell.sh
@@ -1,11 +1,11 @@
 #!/usr/bin/env bash
 #
-# Wire ~/.zshenv and ~/.zshrc into OmacOS.
+# Wire ~/.zshrc into OmacOS: OmacOS fully owns ~/.zshrc. Any existing file is
+# backed up (timestamped) and then completely overwritten with the managed
+# setup below, which sets the tools' shell hooks in the EXACT required order.
+# Re-running backs up again and rewrites the file from scratch.
 #
-# ~/.zshenv  — env vars (sourced by ALL zsh: scripts, editors, cron, login)
-#   EDITOR, VISUAL, PATH additions, BAT_THEME
-#
-# ~/.zshrc   — interactive shell hooks (order matters):
+# The order matters:
 #   1. mise activate              (sets up shims/PATH)
 #   2. fzf + zoxide hooks
 #   3. zsh-autosuggestions        (sourced BEFORE prompt)
@@ -13,8 +13,11 @@
 #   5. starship init              (prompt)
 #   6. zsh-syntax-highlighting    (absolutely LAST: wraps ZLE widgets)
 #
-# Both files are fully owned by OmacOS and overwritten on each run (backup
-# preserved). Users add personal overrides in ~/.zshenv.local / ~/.zshrc.local.
+# EDITOR is set to "zed --wait" because Zed is the primary editor; nvim is
+# only an SSH/headless fallback.
+#
+# Markers are kept as "omacos starship" for backward compatibility with the
+# initial release, even though the block now contains the whole managed shell setup.
 #
 set -euo pipefail
 
@@ -25,70 +28,47 @@ ok(){   printf "${GREEN} ok${RESET} %s\n" "$1"; }
 note(){ printf "${PURPLE} -- ${RESET}%s\n" "$1"; }
 warn(){ printf "${RED} !! ${RESET}%s\n" "$1"; }
 
-zshenv="$HOME/.zshenv"
 zshrc="$HOME/.zshrc"
 
-open_marker='# >>> omacos >>>'
-close_marker='# <<< omacos <<<'
+open_marker='# >>> omacos starship >>>'
+close_marker='# <<< omacos starship <<<'
 
 # Detect brew prefix for plugin source paths
 brew_prefix=""
 command -v brew >/dev/null 2>&1 && brew_prefix="$(brew --prefix 2>/dev/null || true)"
 [[ -z "$brew_prefix" ]] && brew_prefix="/opt/homebrew"
 
-write_file() {
-  local file="$1"; shift
-  local content_fn="$1"
-  if [[ -f "$file" ]]; then
-    ts="$(date +%Y%m%d-%H%M%S)"
-    cp "$file" "$file.bak.$ts"
-    info "Backed up $file to $file.bak.$ts"
-  fi
-  {
-    printf "%s\n" "$open_marker"
-    $content_fn
-    printf "%s\n" "$close_marker"
-  } > "$file"
-}
-
-# --- ~/.zshenv: environment variables (all zsh invocations) ------------------
-zshenv_body() {
+block_body() {
   cat <<BLOCK
-# AUTO-GENERATED by OmacOS (install/shell.sh). DO NOT EDIT.
-# Overwritten on each ./install.sh run; previous version saved as .bak.
-# Personal overrides: ~/.zshenv.local (never touched by OmacOS).
+# ============================================================================
+# AUTO-GENERATED by OmacOS (install/shell.sh). DO NOT EDIT THIS FILE.
+# It is completely overwritten on every ./install.sh run; the previous version
+# is saved as ~/.zshrc.bak.<timestamp>.
+#
+# For your own shell config, create ~/.zshrc.local. It is sourced near the end
+# of this file (just before syntax highlighting) and OmacOS never touches it.
+# ============================================================================
 
-# Editor: Zed primary (GUI); override to nvim in SSH/headless contexts.
+# --- OmacOS managed shell setup (order matters) ---
+# Editor: Zed primary (GUI); override to nvim ad hoc in SSH/headless contexts.
 export EDITOR="zed --wait"
 export VISUAL="\$EDITOR"
 
-# User-local binaries (uv, pipx, cargo, etc.) take priority.
-export PATH="\$HOME/.local/bin:\$PATH"
-
-# bat theme default; themes/<name>/zsh.zsh may override via BAT_THEME.
-export BAT_THEME="\${BAT_THEME:-base16}"
-
-[[ -f "\$HOME/.zshenv.local" ]] && source "\$HOME/.zshenv.local"
-BLOCK
-}
-
-# --- ~/.zshrc: interactive shell hooks (order matters) -----------------------
-zshrc_body() {
-  cat <<BLOCK
-# AUTO-GENERATED by OmacOS (install/shell.sh). DO NOT EDIT.
-# Overwritten on each ./install.sh run; previous version saved as .bak.
-# Personal overrides: ~/.zshrc.local (never touched by OmacOS).
-
 # Disable XON/XOFF flow control so Ctrl+S is available for history search.
 stty -ixon 2>/dev/null || true
 
+# User-local binaries (uv, pipx, and other ~/.local/bin installs) take priority.
+export PATH="\$HOME/.local/bin:\$PATH"
+
 # 1. mise: language version manager (Node/Python/Go/Rust via rustup)
 if command -v mise >/dev/null 2>&1; then
   eval "\$(mise activate zsh)"
 fi
 
 # Completion system: initialise compsys, then make Tab completion (including
-# paths) case-insensitive so e.g. \`cd dow<Tab>\` completes \`Downloads\`.
+# paths) case-insensitive so e.g. \`cd dow<Tab>\` completes \`Downloads\`. The
+# matcher-list maps either case to either. Runs before fzf, whose completion
+# relies on compinit having run.
 autoload -Uz compinit
 compinit -u 2>/dev/null || compinit
 zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}'
@@ -101,7 +81,8 @@ if command -v zoxide >/dev/null 2>&1; then
   eval "\$(zoxide init zsh)"
 fi
 
-# Suppress the end-of-partial-line marker (reverse-video block in Terminal.app).
+# Suppress the end-of-partial-line marker — it renders as a reverse-video block
+# in Terminal.app which inherits the ANSI cyan color and produces a cyan square.
 PROMPT_SP=""
 
 # 3. zsh-autosuggestions: fish-style history suggestions
@@ -119,21 +100,34 @@ if command -v starship >/dev/null 2>&1; then
   eval "\$(starship init zsh)"
 fi
 
-# 6. zsh-syntax-highlighting: MUST be sourced before .zshrc.local (wraps ZLE widgets)
-if [[ -f "$brew_prefix/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" ]]; then
-  source "$brew_prefix/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
-fi
+# bat (cat replacement); themes can override BAT_THEME in their theme.zsh
+export BAT_THEME="\${BAT_THEME:-base16}"
 
-# Personal overrides: always last so user settings win over everything.
+# Personal overrides: your own config lives here, sourced before syntax
+# highlighting so it can define aliases/exports/widgets and still get wrapped.
 # OmacOS never edits ~/.zshrc.local.
 [[ -f "\$HOME/.zshrc.local" ]] && source "\$HOME/.zshrc.local"
+
+# 6. zsh-syntax-highlighting: MUST be sourced last (it wraps ZLE widgets)
+if [[ -f "$brew_prefix/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" ]]; then
+  source "$brew_prefix/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
+fi
 BLOCK
 }
 
-write_file "$zshenv" zshenv_body
-ok "Wrote ~/.zshenv (env vars)"
+# Back up any existing ~/.zshrc, then completely overwrite it: OmacOS fully
+# owns this file. The backup preserves whatever the user (or another tool) had.
+if [[ -f "$zshrc" ]]; then
+  ts="$(date +%Y%m%d-%H%M%S)"
+  cp "$zshrc" "$zshrc.bak.$ts"
+  info "Backed up existing $zshrc to $zshrc.bak.$ts"
+fi
 
-write_file "$zshrc" zshrc_body
-ok "Wrote ~/.zshrc (interactive hooks)"
+{
+  printf "%s\n" "$open_marker"
+  block_body
+  printf "%s\n" "$close_marker"
+} > "$zshrc"
+ok "Overwrote $zshrc with the managed OmacOS shell setup"
 
 note "Start a new shell or 'exec zsh' to pick up changes."
diff --git a/macos/input.sh b/macos/input.sh
index bf4c09c..f8da49c 100755
--- a/macos/input.sh
+++ b/macos/input.sh
@@ -52,4 +52,26 @@ defaults write com.apple.driver.AppleBluetoothMultitouch.trackpad TrackpadThreeF
 defaults write com.apple.AppleMultitouchTrackpad TrackpadThreeFingerDrag -bool true
 ok "Three-finger drag enabled"
 
+# --- Globe (fn) key: do nothing ---------------------------------------------
+info "Globe key: do nothing"
+defaults write com.apple.HIToolbox AppleFnUsageType -integer 0
+ok "Globe key set to do nothing"
+
+# --- Keyboard navigation: off -----------------------------------------------
+# Tab cycles through text fields only (not all controls on screen).
+info "Keyboard navigation off (text fields only)"
+defaults write -g AppleKeyboardUIMode -int 0
+ok "Keyboard navigation off"
+
+# --- Keyboard backlight: auto-dim in low light ------------------------------
+info "Keyboard backlight: auto-dim in low light"
+defaults write com.apple.BezelServices.kDim -bool true
+ok "Keyboard backlight auto-dim enabled"
+
+# --- Dictation: off, auto-punctuation off -----------------------------------
+info "Dictation off, auto-punctuation off"
+defaults write com.apple.HIToolbox AppleDictationAutoEnable -int 0
+defaults write com.apple.SpeechRecognitionCore SpeechRecognitionAutoPunctuateEnabled -bool false
+ok "Dictation disabled"
+
 note "Log out and back in for key repeat and press-and-hold to take effect everywhere."
