config-file = theme.conf
font-family = JetBrainsMono Nerd Font
font-size = 14
window-padding-x = 0
window-padding-y = 0
window-decoration = false
window-save-state = always
background-opacity = 1.0
copy-on-select = clipboard
cursor-style = block_hollow
cursor-style-blink = false
cursor-click-to-move = true
macos-auto-secure-input = true

# Auto-launch into tmux. -A attaches to session "main" if it exists, creates it
# otherwise. Combined with tmux-continuum (15-min auto-save + restore-on-start),
# accidental window closes and reboots lose nothing.
command = /opt/homebrew/bin/tmux new-session -A -s main

# --- tmux keybindings ---
# \x01 = Ctrl+A (tmux prefix). Ghostty reads exactly 2 hex digits so the
# character after \x01 is always treated as a literal (e.g. \x01c = Ctrl+A + c).

# Windows
keybind = cmd+t=text:\x01c
keybind = cmd+w=text:\x04
keybind = cmd+shift+w=text:\x01&
keybind = cmd+shift+r=text:\x01,

# Window navigation — ESC+N triggers tmux root-table M-N bindings (no prefix needed).
# Ghostty 1.2+ requires digit1-digit9 for number key physical positions.
keybind = cmd+left_bracket=text:\x1bh
keybind = cmd+right_bracket=text:\x1bl
keybind = cmd+digit1=text:\x1b\x31
keybind = cmd+digit2=text:\x1b\x32
keybind = cmd+digit3=text:\x1b\x33
keybind = cmd+digit4=text:\x1b\x34
keybind = cmd+digit5=text:\x1b\x35
keybind = cmd+digit6=text:\x1b\x36
keybind = cmd+digit7=text:\x1b\x37
keybind = cmd+digit8=text:\x1b\x38
keybind = cmd+digit9=text:\x1b\x39

# Pane splits and navigation
keybind = cmd+d=text:\x01%
keybind = cmd+shift+d=text:\x01"
keybind = cmd+shift+enter=text:\x01z
keybind = cmd+opt+up=text:\x01k
keybind = cmd+opt+down=text:\x01j
keybind = cmd+opt+left=text:\x01h
keybind = cmd+opt+right=text:\x01l

# Shift+Enter sends a newline without submitting (useful in multi-line inputs)
keybind = shift+enter=text:\n
